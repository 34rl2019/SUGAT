# REQUIRED IN ALL API ENVIRONMENTS
DATABASE_URL=postgresql://sugat_app:CHANGE_ME@127.0.0.1:5432/sugat
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret

# REQUIRED IN PRODUCTION
NODE_ENV=production
HOST=127.0.0.1
PORT=5002
# Optional. Keep false/omitted unless API documentation must be public.
ENABLE_API_DOCS=false
REDIS_URL=redis://127.0.0.1:6379/2
CORS_ORIGINS=https://sugata.online,https://www.sugata.online,https://admin.sugata.online

# OPTIONAL TUNING
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
LIVE_AFTER_SECONDS=20
STALE_AFTER_SECONDS=120
OFFLINE_AFTER_SECONDS=600
APPROACHING_STOP_METERS=1500
ARRIVED_STOP_METERS=150

# DEVELOPMENT ONLY (web/mobile builds use their own environment files)
# NODE_ENV=development
# HOST=0.0.0.0
# PORT=3000
# DATABASE_URL=postgresql://sugat:sugat@127.0.0.1:5432/sugat
# REDIS_URL=redis://127.0.0.1:6379
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174
