{
  "name": "@sugat/passenger-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android --device",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "doctor": "expo-doctor",
    "export:android": "expo export --platform android",
    "build:android:development": "npx eas-cli@latest build --platform android --profile development",
    "build:android:preview": "npx eas-cli@latest build --platform android --profile preview",
    "build:android:production": "npx eas-cli@latest build --platform android --profile production",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@maplibre/maplibre-react-native": "10.4.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "11.4.1",
    "@sugat/shared-types": "workspace:*",
    "@sugat/theme": "workspace:*",
    "@types/geojson": "^7946.0.16",
    "expo": "~52.0.47",
    "expo-asset": "~11.0.5",
    "expo-build-properties": "~0.13.3",
    "expo-location": "~18.0.10",
    "expo-notifications": "~0.29.14",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "expo-doctor": "^1.13.1",
    "typescript": "^5.7.3"
  }
