generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum Role {
  DRIVER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  PENDING_REVERIFICATION
}

enum VerificationDocumentType {
  LICENSE_FRONT
  LICENSE_BACK
  SELFIE
}

enum VehicleType {
  BUS
  VAN
  SHUTTLE
}

enum TripStatus {
  SCHEDULED
  READY
  ACTIVE
  COMPLETED
  CANCELLED
}

enum OccupancyStatus {
  VACANT
  FULL
}

enum TripEventType {
  STARTED
  LOCATION_ACCEPTED
  STOP_APPROACHING
  STOP_ARRIVED
  STOP_PASSED
  COMPLETED
  CANCELLED
  GPS_STALE
}

enum GpsIngestionStatus {
  PROMOTED
  REJECTED
  STALE
}

model User {
  id            String           @id @default(uuid()) @db.Uuid
  email         String           @unique
  phone         String?          @unique
  passwordHash  String
  role          Role
  accountStatus AccountStatus    @default(ACTIVE)
  mustChangePassword Boolean     @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  driver        Driver?
  sessions      RefreshSession[]
  auditLogs     AuditLog[]       @relation("AuditActor")
  reviewedVerificationSubmissions DriverVerificationSubmission[] @relation("VerificationReviewer")
}

model Driver {
  id               String     @id @default(uuid()) @db.Uuid
  userId           String     @unique @db.Uuid
  firstName        String
  middleName       String?
  lastName         String
  photoUrl         String?
  licenseNumber    String?
  licenseExpiresAt DateTime?
  identityVerificationStatus VerificationStatus @default(UNVERIFIED)
  licenseVerificationStatus  VerificationStatus @default(UNVERIFIED)
  active           Boolean    @default(true)
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles         Vehicle[]  @relation("AssignedDriver")
  trips            Trip[]
  schedules        Schedule[]
  verificationSubmissions DriverVerificationSubmission[]
  authorizedRoutes DriverRouteAuthorization[]
  authorizedDevice DriverDevice?

  @@index([identityVerificationStatus])
  @@index([licenseVerificationStatus])
}

model DriverRouteAuthorization {
  driverId String @db.Uuid
  routeId String @db.Uuid
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  @@id([driverId, routeId])
  @@index([routeId])
}

model DriverDevice {
  id String @id @default(uuid()) @db.Uuid
  driverId String @unique @db.Uuid
  credentialHash String
  authorizedAt DateTime @default(now())
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model DriverVerificationSubmission {
  id             String             @id @default(uuid()) @db.Uuid
  driverId       String             @db.Uuid
  status         VerificationStatus @default(PENDING_VERIFICATION)
  rejectionReason String?
  submittedAt    DateTime           @default(now())
  reviewedAt     DateTime?
  reviewedById   String?            @db.Uuid
  driver         Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)
  documents      DriverVerificationDocument[]
  reviewedBy     User?              @relation("VerificationReviewer", fields: [reviewedById], references: [id])

  @@index([driverId, submittedAt])
  @@index([status, submittedAt])
}

model DriverVerificationDocument {
  id           String                   @id @default(uuid()) @db.Uuid
  submissionId String                   @db.Uuid
  type         VerificationDocumentType
  storageKey   String                   @unique
  mimeType     String
  sizeBytes    Int
  sha256       String
  createdAt    DateTime                 @default(now())
  submission   DriverVerificationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, type])
}

model Vehicle {
  id               String      @id @default(uuid()) @db.Uuid
  type             VehicleType
  plateNumber      String      @unique
  conductionSticker String?
  bodyNumber       String?
  displayName      String
  brand            String?
  model            String?
  capacity         Int?
  photoUrl         String?
  active           Boolean     @default(true)
  assignedDriverId String?     @db.Uuid
  assignedDriver   Driver?     @relation("AssignedDriver", fields: [assignedDriverId], references: [id])
  trips            Trip[]
  schedules        Schedule[]
  currentLocations VehicleCurrentLocation[]
}

model Stop {
  id               String      @id @default(uuid()) @db.Uuid
  name             String
  description      String?
  cityMunicipality String?
  province         String?
  latitude         Float
  longitude        Float
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  routeStops       RouteStop[]
}

model Route {
  id        String      @id @default(uuid()) @db.Uuid
  name      String
  direction String
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  stops     RouteStop[]
  schedules Schedule[]
  trips     Trip[]
  authorizedDrivers DriverRouteAuthorization[]
}

model RouteStop {
  id                  String  @id @default(uuid()) @db.Uuid
  routeId             String  @db.Uuid
  stopId              String  @db.Uuid
  sequence            Int
  boardingAllowed     Boolean @default(true)
  dropoffAllowed      Boolean @default(true)
  minutesFromPrevious Int?
  route               Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop                Stop    @relation(fields: [stopId], references: [id])

  @@unique([routeId, sequence])
  @@unique([routeId, stopId])
  @@index([stopId, routeId])
}

model Schedule {
  id          String   @id @default(uuid()) @db.Uuid
  routeId     String   @db.Uuid
  driverId    String   @db.Uuid
  vehicleId   String   @db.Uuid
  departureAt DateTime
  active      Boolean  @default(true)
  route       Route    @relation(fields: [routeId], references: [id])
  driver      Driver   @relation(fields: [driverId], references: [id])
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  trip        Trip?

  @@index([driverId, departureAt])
  @@index([vehicleId, departureAt])
}

model Trip {
  id                   String                  @id @default(uuid()) @db.Uuid
  scheduleId           String?                 @unique @db.Uuid
  routeId              String                  @db.Uuid
  driverId             String                  @db.Uuid
  vehicleId            String                  @db.Uuid
  status               TripStatus              @default(SCHEDULED)
  scheduledDepartureAt DateTime?
  occupancyStatus      OccupancyStatus?
  occupancyUpdatedAt   DateTime?
  startedAt            DateTime?
  endedAt              DateTime?
  lastLocationAt       DateTime?
  lastPassedSequence   Int                     @default(0)
  schedule             Schedule?               @relation(fields: [scheduleId], references: [id])
  route                Route                   @relation(fields: [routeId], references: [id])
  driver               Driver                  @relation(fields: [driverId], references: [id])
  vehicle              Vehicle                 @relation(fields: [vehicleId], references: [id])
  currentLocation      VehicleCurrentLocation?
  gpsIngestionEvents   GpsIngestionEvent[]
  events               TripEvent[]

  @@index([status, lastLocationAt])
  @@index([driverId, status])
  @@index([vehicleId, status])
  @@map("trips")
}

model VehicleCurrentLocation {
  tripId     String   @id @db.Uuid
  vehicleId  String   @db.Uuid
  latitude   Float
  longitude  Float
  accuracy   Float
  speed      Float?
  heading    Float?
  recordedAt DateTime
  updatedAt  DateTime @updatedAt
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, recordedAt])
}

model GpsIngestionEvent {
  eventId         String             @id
  tripId          String             @db.Uuid
  status          GpsIngestionStatus
  rejectionReason String?
  receivedAt      DateTime           @default(now())
  expiresAt       DateTime
  trip            Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, receivedAt])
  @@index([expiresAt])
}

model TripEvent {
  id        String        @id @default(uuid()) @db.Uuid
  tripId    String        @db.Uuid
  type      TripEventType
  stopId    String?       @db.Uuid
  sequence  Int?
  metadata  Json?
  createdAt DateTime      @default(now())
  trip      Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, type, stopId])
  @@index([tripId, createdAt])
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  driverDeviceId String? @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
}
